# Environment Configuration
NODE_ENV=development
PORT=5000

# Database - Option 1: Individual settings (local development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=school_erp
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Database - Option 2: Full URL (for Docker/Production)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/school_erp
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/school_erp

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Default Settings
DEFAULT_ACADEMIC_YEAR=2025-26
